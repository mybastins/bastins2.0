# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens — set this to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# PayU (payments.payu.in) — Merchant Dashboard > Settings > API/Salt
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-salt
# "test" uses test.payu.in (sandbox); "live" uses secure.payu.in (real payments)
PAYU_MODE=test
